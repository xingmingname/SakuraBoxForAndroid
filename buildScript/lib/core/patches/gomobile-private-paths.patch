+// Copyright 2026 SakuraBox contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"golang.org/x/mod/modfile"
+)
+
+// Keep real local module replacements while avoiding machine-specific absolute
+// directories in Go build information. Paths are relative to the generated
+// go.mod, not the source module or the caller's working directory.
+func relativeLocalReplacements(f *modfile.File, dir string) error {
+	base, err := filepath.Abs(dir)
+	if err != nil {
+		return fmt.Errorf("resolve generated module directory: %w", err)
+	}
+	for _, replacement := range f.Replace {
+		if replacement.New.Version != "" || !filepath.IsAbs(replacement.New.Path) {
+			continue
+		}
+		relative, err := filepath.Rel(base, replacement.New.Path)
+		if err != nil {
+			// Do not silently preserve an absolute path on another volume.
+			return fmt.Errorf("local replacement for %s cannot be made relative", replacement.Old.Path)
+		}
+		relative = filepath.ToSlash(relative)
+		if relative != "." && !strings.HasPrefix(relative, "./") && !strings.HasPrefix(relative, "../") {
+			relative = "./" + relative
+		}
+		if err := f.AddReplace(replacement.Old.Path, replacement.Old.Version, relative, ""); err != nil {
+			return fmt.Errorf("update local replacement for %s: %w", replacement.Old.Path, err)
+		}
+	}
+	return nil
+}
