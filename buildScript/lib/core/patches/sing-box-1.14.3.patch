+type uiCountingZeros struct{ read int64 }
+
+func (r *uiCountingZeros) Read(p []byte) (int, error) {
+	for i := range p {
+		p[i] = 0
+	}
+	r.read += int64(len(p))
+	return len(p), nil
+}
