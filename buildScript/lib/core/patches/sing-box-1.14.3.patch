+}
+func TestUISecureDownloadArchive(t *testing.T) {
+	cases := []struct {
+		name  string
+		entry uiTestEntry
+		valid bool
+	}{
+		{"normal", uiTestEntry{"bundle/assets/a.js", "ok", 0}, true},
+		{"traversal", uiTestEntry{"bundle/../escape", "bad", 0}, false},
+		{"absolute", uiTestEntry{"/escape", "bad", 0}, false},
+		{"drive", uiTestEntry{"C:/escape", "bad", 0}, false},
+		{"backslash", uiTestEntry{`bundle\..\escape`, "bad", 0}, false},
+		{"symlink", uiTestEntry{"bundle/link", "../../outside", os.ModeSymlink | 0777}, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			parent := t.TempDir()
+			output := filepath.Join(parent, "ui")
+			if err := os.Mkdir(output, 0700); err != nil {
+				t.Fatal(err)
+			}
+			os.WriteFile(filepath.Join(output, "index.html"), []byte("previous-ui"), 0600)
+			err := uiTestServer(t).downloadZIP(bytes.NewReader(uiTestZIP(t, uiTestEntry{"bundle/index.html", "new-ui", 0}, c.entry)), output)
+			if (err == nil) != c.valid {
+				t.Fatalf("valid=%v, error=%v", c.valid, err)
+			}
+			got, _ := os.ReadFile(filepath.Join(output, "index.html"))
+			want := "previous-ui"
+			if c.valid {
+				want = "new-ui"
+			}
+			if string(got) != want {
+				t.Fatal("previous UI was damaged on failure")
+			}
+			if _, e := os.Stat(filepath.Join(parent, "escape")); !os.IsNotExist(e) {
+				t.Fatal("archive escaped UI")
+			}
+			stage, _ := filepath.Glob(filepath.Join(parent, ".yacd-*"))
+			if len(stage) != 0 {
+				t.Fatal("staging or backup directory leaked")
+			}
+		})
+	}
+}
+func TestUIArchiveQuotasAndCancellation(t *testing.T) {
+	data := uiTestZIP(t, uiTestEntry{"index.html", "1234567890", 0}, uiTestEntry{"asset.js", "1234", 0})
+	for _, c := range []struct {
+		name        string
+		total, file uint64
+		count       int
+	}{
+		{"entry-size", 100, 5, 10}, {"total-size", 12, 20, 10}, {"entry-count", 100, 20, 1},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			reader, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			output := filepath.Join(t.TempDir(), "ui")
+			if err = installUIArchive(context.Background(), reader, output, c.total, c.file, c.count); err == nil {
+				t.Fatal("quota accepted")
+			}
+			if _, err = os.Stat(output); !os.IsNotExist(err) {
+				t.Fatal("quota failure created UI")
+			}
+		})
+	}
+	s := uiTestServer(t)
+	ctx, cancel := context.WithCancel(s.ctx)
+	cancel()
+	s.ctx = ctx
+	if err := s.downloadZIP(bytes.NewReader(data), filepath.Join(t.TempDir(), "ui")); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", err)
+	}
+}
