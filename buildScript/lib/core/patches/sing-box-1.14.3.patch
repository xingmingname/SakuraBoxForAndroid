diff --git a/common/tls/certificate_options.go b/common/tls/certificate_options.go
new file mode 100644
--- /dev/null
+++ b/common/tls/certificate_options.go
@@ -0,0 +1,36 @@
+package tls
+
+import (
+	"crypto/sha256"
+
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// Empty optional values do not select a verification method. Work on a copy;
+// callers retain the original configuration for editing and export.
+func effectiveCertificateOptions(options option.OutboundTLSOptions) (option.OutboundTLSOptions, error) {
+	if options.Certificate != nil {
+		certificates := make([]string, 0, len(options.Certificate))
+		for _, certificate := range options.Certificate {
+			if certificate != "" {
+				certificates = append(certificates, certificate)
+			}
+		}
+		options.Certificate = certificates
+	}
+	if options.CertificatePublicKeySHA256 != nil {
+		pins := make([][]byte, 0, len(options.CertificatePublicKeySHA256))
+		for _, pin := range options.CertificatePublicKeySHA256 {
+			if len(pin) == 0 {
+				continue
+			}
+			if (options.Reality == nil || !options.Reality.Enabled) && len(pin) != sha256.Size {
+				return options, E.New("certificate_public_key_sha256: each non-empty pin must be 32 bytes")
+			}
+			pins = append(pins, pin)
+		}
+		options.CertificatePublicKeySHA256 = pins
+	}
+	return options, nil
+}
