+func TestUIDirectoryPreflightLimits(t *testing.T) {
+	ordinary := uiTestZIP(t, uiTestEntry{"index.html", "new-ui", 0})
+	at := len(ordinary) - 22
+	end := ordinary[at:]
+	large := make([]byte, 56)
+	binary.LittleEndian.PutUint32(large[:4], 0x06064b50)
+	binary.LittleEndian.PutUint64(large[4:12], 44)
+	binary.LittleEndian.PutUint64(large[24:32], 1)
+	binary.LittleEndian.PutUint64(large[32:40], 1)
+	binary.LittleEndian.PutUint64(large[40:48], uint64(binary.LittleEndian.Uint32(end[12:16])))
+	binary.LittleEndian.PutUint64(large[48:56], uint64(binary.LittleEndian.Uint32(end[16:20])))
+	locator := make([]byte, 20)
+	binary.LittleEndian.PutUint32(locator[:4], 0x07064b50)
+	binary.LittleEndian.PutUint64(locator[8:16], uint64(at))
+	binary.LittleEndian.PutUint32(locator[16:20], 1)
+	last := append([]byte(nil), end...)
+	binary.LittleEndian.PutUint16(last[8:10], 0xffff)
+	binary.LittleEndian.PutUint16(last[10:12], 0xffff)
+	binary.LittleEndian.PutUint32(last[12:16], 0xffffffff)
+	binary.LittleEndian.PutUint32(last[16:20], 0xffffffff)
+	zip64 := append(append(append(append([]byte(nil), ordinary[:at]...), large...), locator...), last...)
+	if err := uiTestServer(t).downloadZIP(bytes.NewReader(zip64), filepath.Join(t.TempDir(), "ui")); err != nil {
+		t.Fatal("valid ZIP64 rejected", err)
+	}
+	entries := make([]uiTestEntry, maxUIEntries+1)
+	for i := range entries {
+		entries[i] = uiTestEntry{fmt.Sprintf("%d", i), "", 0}
+	}
+	tooMany := uiTestZIP(t, entries...)
+	// Check actual central records before archive/zip allocates its File list,
+	// even if a malicious EOCD underreports the count.
+	binary.LittleEndian.PutUint16(tooMany[len(tooMany)-22+10:], 1)
+	if err := validateUIDirectory(context.Background(), bytes.NewReader(tooMany), int64(len(tooMany))); err == nil {
+		t.Fatal("forged record count bypassed preflight")
+	}
+	if err := validateUIDirectory(context.Background(), bytes.NewReader([]byte("bad")), 3); err == nil {
+		t.Fatal("invalid directory accepted")
+	}
+}
