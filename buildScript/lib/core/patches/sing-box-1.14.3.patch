+type uiFailingReader struct{ data []byte }
+
+func (r *uiFailingReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, errors.New("synthetic download failure")
+	}
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	return n, nil
+}
+func TestUIFailedDownloadKeepsPrevious(t *testing.T) {
+	for _, body := range []io.Reader{strings.NewReader("not a ZIP"), &uiFailingReader{[]byte("partial")}} {
+		output := filepath.Join(t.TempDir(), "ui")
+		os.Mkdir(output, 0700)
+		os.WriteFile(filepath.Join(output, "index.html"), []byte("previous"), 0600)
+		s := uiTestServer(t)
+		if err := s.downloadZIP(body, output); err == nil {
+			t.Fatal("invalid download accepted")
+		}
+		got, _ := os.ReadFile(filepath.Join(output, "index.html"))
+		if string(got) != "previous" {
+			t.Fatal("old UI lost")
+		}
+		leftovers, _ := filepath.Glob(filepath.Join(filemanager.TempPath(s.ctx), "external-ui-*.zip"))
+		if len(leftovers) != 0 {
+			t.Fatal("temporary archive leaked")
+		}
+	}
+}
