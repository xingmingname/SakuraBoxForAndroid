+func TestUIInstallationRollbackAndExistingSymlink(t *testing.T) {
+	parent := t.TempDir()
+	output := filepath.Join(parent, "ui")
+	os.Mkdir(output, 0700)
+	os.WriteFile(filepath.Join(output, "index.html"), []byte("previous"), 0600)
+	s := uiTestServer(t)
+	manager := service.FromContext[filemanager.Manager](s.ctx)
+	s.ctx = service.ContextWith[filemanager.Manager](s.ctx, uiFailRename{manager, output})
+	data := uiTestZIP(t, uiTestEntry{"index.html", "new", 0})
+	if err := s.downloadZIP(bytes.NewReader(data), output); err == nil {
+		t.Fatal("injected failure ignored")
+	}
+	got, _ := os.ReadFile(filepath.Join(output, "index.html"))
+	if string(got) != "previous" {
+		t.Fatal("rollback failed")
+	}
+	outside := t.TempDir()
+	link := filepath.Join(parent, "linked-ui")
+	if err := os.Symlink(outside, link); err != nil {
+		t.Log("symlink creation unavailable; lexical/ZIP symlink rejection still tested")
+		return
+	}
+	if err := uiTestServer(t).downloadZIP(bytes.NewReader(data), link); err == nil {
+		t.Fatal("destination symlink accepted")
+	}
+	if _, err := os.Stat(filepath.Join(outside, "index.html")); !os.IsNotExist(err) {
+		t.Fatal("destination symlink followed")
+	}
+}
